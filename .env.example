# Copy to .env — never commit real secrets.

PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/agriprice
MONGODB_DB_NAME=agriprice
# Legacy alias (optional)
# MONGO_URI=
NODE_ENV=development
DISABLE_CRON=false

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173,https://transcendent-liger-f7f44d.netlify.app

# --- Free-tier AI (Google AI Studio): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Free-tier media (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or single URL:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Africa's Talking (sandbox is free for testing)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
USSD_CODE=*384#
